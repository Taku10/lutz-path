# Optional host-port overrides. Copy this file to .env if ports 5001-5003 are busy.
# These only affect URLs on your computer; container-to-container traffic uses 8080.
USER_SERVICE_PORT=5001
JOB_APPLICATION_SERVICE_PORT=5002
REMINDER_SERVICE_PORT=5003

FRONTEND_PORT=3000

# Only needed with docker-compose.sheets.yml; forward slashes work on Windows.
# GOOGLE_SHEETS_CREDENTIALS_FILE=C:/Users/your-name/Downloads/service-account.json

# Enable only after source ID reconciliation; requires both Compose files.
# GOOGLE_SHEETS_AUTOMATIC_SYNC=true
